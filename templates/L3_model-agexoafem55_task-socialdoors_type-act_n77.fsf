set feat_files(1) "/ZPOOL/data/projects/rf1-sra-socdoors/derivatives/fsl/sub-10418/ses-01/L1_task-socialdoors_ses-01_model-1_type-REPLACEME_run-1_sm-5.feat/stats/copeCOPENUM.nii.gz"

